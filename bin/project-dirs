#!/usr/bin/env zsh
# Prints the candidate project directories for the sessionizers, one per line.
# Shared by tmux-sessionizer and herdr-sessionizer so both pick from the same list.
{
  echo ~/.dotfiles
  find ~/Code/Ingrid -mindepth 1 -maxdepth 1 -type d
  find ~/Code -mindepth 1 -maxdepth 1 -type d
  echo ~/Notes
} | sort
